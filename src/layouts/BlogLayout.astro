---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  description?: string
  authors?: string[]
  date?: string
  lastUpdated?: number
}

const { title, description, authors = [], date, lastUpdated } = Astro.props

function formatAuthors(list: string[]): string {
  if (list.length === 0) return ''
  if (list.length === 1) return list[0]
  if (list.length === 2) return `${list[0]} & ${list[1]}`
  return list.slice(0, -1).join(', ') + ' & ' + list[list.length - 1]
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
}

const authorList = formatAuthors(authors)
---

<BaseLayout title={title} description={description}>
  <article class="blog-post">
    <header class="blog-header">
      <h1>{title}</h1>
      {(authorList || date) && (
        <div class="blog-byline">
          {authorList && (
            <div class="author-info">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              <span>{authorList}</span>
            </div>
          )}
          {date && (
            <div class="date-info">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              <time datetime={date}>{formatDate(date)}</time>
            </div>
          )}
        </div>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
    {lastUpdated && (
      <footer class="blog-footer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M23 4v6h-6"/>
          <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
        </svg>
        Updated {new Date(lastUpdated).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
      </footer>
    )}
  </article>
</BaseLayout>

<style>
.blog-post {
  max-width: 720px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}
.blog-header {
  margin-bottom: 2rem;
}
.blog-header h1 {
  font-size: 2.25rem;
  font-weight: 700;
  margin: 0 0 1rem;
  line-height: 1.2;
}
.blog-byline {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.5rem;
  padding: 1rem 1.25rem;
  background: var(--vp-c-bg-soft, #f3f4f6);
  border-radius: 8px;
  border-left: 3px solid var(--vp-c-brand-1, #3b82f6);
}
.author-info, .date-info {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.author-info svg {
  color: var(--vp-c-brand-1, #3b82f6);
}
.date-info svg {
  color: var(--vp-c-text-3, #6b7280);
}
.author-info span {
  font-weight: 500;
}
.date-info time {
  color: var(--vp-c-text-2, #4b5563);
}
.blog-footer {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  margin-top: 3rem;
  padding-top: 1rem;
  border-top: 1px solid var(--vp-c-divider, #e5e7eb);
  font-size: 0.8125rem;
  color: var(--vp-c-text-3, #6b7280);
}

@media (max-width: 640px) {
  .blog-byline {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
}
</style>
