---
import BaseLayout from './BaseLayout.astro'
import { deriveBreadcrumbs } from './seo'

interface Props {
  title: string
  description?: string
  authors?: string[]
  date?: string
  lastUpdated?: number
}

const { title, description, authors = [], date, lastUpdated } = Astro.props

function formatAuthors(list: string[]): string {
  if (list.length === 0) return ''
  if (list.length === 1) return list[0]
  if (list.length === 2) return `${list[0]} & ${list[1]}`
  return list.slice(0, -1).join(', ') + ' & ' + list[list.length - 1]
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
}

const authorList = formatAuthors(authors)
const breadcrumbs = deriveBreadcrumbs(Astro.url.pathname)
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} publishedAt={date}>
  <article class="blog-post">
    <header class="blog-header">
      <div class="blog-header-inner">
        <a href="/blog/" class="blog-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          Blog
        </a>
        <h1 class="blog-title">{title}</h1>
        {description && <p class="blog-description">{description}</p>}
        {(authorList || date) && (
          <div class="blog-byline">
            {authorList && (
              <span class="blog-author">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                {authorList}
              </span>
            )}
            {date && (
              <time datetime={date} class="blog-date">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                {formatDate(date)}
              </time>
            )}
          </div>
        )}
      </div>
    </header>

    <div class="blog-content prose">
      <slot />
    </div>

    {lastUpdated && (
      <footer class="blog-footer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M23 4v6h-6"/>
          <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
        </svg>
        Updated {new Date(lastUpdated).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
      </footer>
    )}
  </article>
</BaseLayout>

<style>
.blog-post {
  max-width: 760px;
  margin: 0 auto;
}

.blog-header {
  position: relative;
  padding: 4rem 1.5rem 3rem;
  border-bottom: 1px solid var(--g-divider);
}
.blog-header-inner {
  max-width: 760px;
  margin: 0 auto;
}
.blog-back {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--g-font-display);
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--g-text-3);
  text-decoration: none;
  margin-bottom: 1.5rem;
  transition: color 0.15s;
}
.blog-back:hover {
  color: var(--g-brand);
}
.blog-title {
  font-family: var(--g-font-display);
  font-size: clamp(2rem, 4vw, 2.75rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin: 0 0 1rem;
  color: var(--g-text-1);
}
.blog-description {
  font-family: 'EB Garamond', Georgia, serif;
  font-style: italic;
  font-size: 1.25rem;
  line-height: 1.5;
  color: var(--g-text-2);
  margin: 0 0 1.5rem;
}
.blog-byline {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  font-size: 0.875rem;
  color: var(--g-text-2);
}
.blog-author,
.blog-date {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}
.blog-author svg { color: var(--g-teal); }
.blog-date svg { color: var(--g-text-3); }

.blog-content {
  padding: 3rem 1.5rem;
  max-width: none;
}

.blog-footer {
  max-width: 760px;
  margin: 0 auto;
  padding: 0 1.5rem 3rem;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.8125rem;
  color: var(--g-text-3);
}

@media (max-width: 640px) {
  .blog-header { padding: 3rem 1.25rem 2rem; }
  .blog-content { padding: 2rem 1.25rem; }
  .blog-footer { padding: 0 1.25rem 2rem; }
  .blog-byline { flex-direction: column; gap: 0.5rem; }
}
</style>
