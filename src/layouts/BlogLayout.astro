---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  description?: string
  authors?: string[]
  date?: string
  lastUpdated?: number
}

const { title, description, authors = [], date, lastUpdated } = Astro.props

function formatAuthors(list: string[]): string {
  if (list.length === 0) return ''
  if (list.length === 1) return list[0]
  if (list.length === 2) return `${list[0]} & ${list[1]}`
  return list.slice(0, -1).join(', ') + ' & ' + list[list.length - 1]
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
}

const authorList = formatAuthors(authors)
---

<BaseLayout title={title} description={description}>
  <article class="max-w-[720px] mx-auto px-6 py-8">
    <header class="mb-8">
      <h1 class="text-4xl font-bold m-0 mb-4 leading-tight">{title}</h1>
      {(authorList || date) && (
        <div class="blog-byline flex items-center flex-wrap gap-6 px-5 py-4 bg-[var(--g-bg-soft)] rounded-lg border-l-4 border-brand">
          {authorList && (
            <div class="flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-brand">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              <span class="font-medium">{authorList}</span>
            </div>
          )}
          {date && (
            <div class="flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--g-text-3)]">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              <time datetime={date} class="text-[var(--g-text-2)]">{formatDate(date)}</time>
            </div>
          )}
        </div>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
    {lastUpdated && (
      <footer class="flex items-center gap-1.5 mt-12 pt-4 border-t border-[var(--g-divider)] text-[13px] text-[var(--g-text-3)]">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M23 4v6h-6"/>
          <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
        </svg>
        Updated {new Date(lastUpdated).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
      </footer>
    )}
  </article>
</BaseLayout>

<style>
@media (max-width: 640px) {
  :global(.blog-byline) {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
}
</style>
