---
import BaseLayout from './BaseLayout.astro'
import Sidebar from '../components/Sidebar.astro'
import Outline from '../components/Outline.astro'

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  title: string
  description?: string
  pathname: string
  headings?: Heading[]
  fullscreen?: boolean
  lastUpdated?: number
}

const {
  title,
  description,
  pathname,
  headings = [],
  fullscreen = false,
  lastUpdated,
} = Astro.props

const showChrome = !fullscreen
---

<BaseLayout title={title} description={description} fullscreen={fullscreen}>
  <div class:list={[
    'doc-container grid gap-8 max-w-[1440px] mx-auto px-6 items-start',
    showChrome ? 'doc-with-chrome' : 'grid-cols-1',
  ]}>
    {showChrome && <Sidebar pathname={pathname} />}
    <main class="py-8 min-w-0">
      <article class="prose">
        <slot />
      </article>
      {showChrome && (
        <div class="mt-12 pt-4 border-t border-[var(--vp-c-divider)] text-xs text-[var(--vp-c-text-2)]">
          {lastUpdated && (
            <span>
              Updated: {new Date(lastUpdated).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
          )}
        </div>
      )}
    </main>
    {showChrome && <Outline headings={headings} />}
  </div>
</BaseLayout>

<style>
.doc-container.doc-with-chrome {
  grid-template-columns: 16rem minmax(0, 1fr) 12rem;
}
.doc-container :global(.prose) {
  max-width: none;
}
@media (max-width: 1024px) {
  .doc-container.doc-with-chrome {
    grid-template-columns: 16rem minmax(0, 1fr);
  }
}
@media (max-width: 768px) {
  .doc-container.doc-with-chrome {
    grid-template-columns: minmax(0, 1fr);
  }
}
</style>
