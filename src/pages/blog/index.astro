---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

const posts = (await getCollection('blog'))
  .sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
}

function formatAuthors(list: string[]): string {
  if (list.length === 0) return ''
  if (list.length === 1) return list[0]
  if (list.length === 2) return `${list[0]} & ${list[1]}`
  return list.slice(0, -1).join(', ') + ' & ' + list[list.length - 1]
}
---

<BaseLayout title="Blog" description="Glossarist blog — announcements and deep dives">
  <div class="blog-index">
    <h1>Blog</h1>
    <p class="blog-tagline">Announcements, release notes, and deep dives from the Glossarist community.</p>
    <ul class="post-list">
      {posts.map(post => (
        <li class="post-card">
          <a href={`/blog/${post.id}`} class="post-link">
            <div class="post-meta">
              <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
              {post.data.authors.length > 0 && (
                <span class="post-authors"> · {formatAuthors(post.data.authors)}</span>
              )}
            </div>
            <h2 class="post-title">{post.data.title}</h2>
            {post.data.description && (
              <p class="post-description">{post.data.description}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
.blog-index {
  max-width: 720px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}
.blog-index h1 {
  font-size: 2.5rem;
  font-weight: 700;
  margin: 0 0 0.5rem;
}
.blog-tagline {
  color: var(--g-text-2, #4b5563);
  margin-bottom: 2.5rem;
}
.post-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.post-card {
  margin-bottom: 2rem;
  padding: 1.5rem;
  border: 1px solid var(--g-divider, #e5e7eb);
  border-radius: 8px;
  transition: border-color 0.15s, transform 0.15s;
}
.post-card:hover {
  border-color: var(--g-brand, #3b82f6);
  transform: translateY(-1px);
}
.post-link {
  display: block;
  color: inherit;
  text-decoration: none;
}
.post-meta {
  font-size: 0.875rem;
  color: var(--g-text-3, #6b7280);
  margin-bottom: 0.5rem;
}
.post-title {
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0 0 0.5rem;
  color: var(--g-brand, #3b82f6);
}
.post-description {
  color: var(--g-text-2, #4b5563);
  margin: 0;
  line-height: 1.5;
}
</style>
