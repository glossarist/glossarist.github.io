---
import { getCollection, render } from 'astro:content'
import DocLayout from '@layouts/DocLayout.astro'
import OntologyBrowser from '@components/OntologyBrowser.vue'
import SchemaReference from '@components/SchemaReference.vue'
import YamlSchemas from '@components/YamlSchemas.vue'

export async function getStaticPaths() {
  const refs = await getCollection('reference')
  return refs
    .filter(entry => entry.id !== 'index')
    .map(entry => ({
      params: { path: entry.id },
      props: { entry },
    }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const pathname = `/reference/${entry.id === 'index' ? '' : entry.id + '/'}`
const isInteractive = entry.data.fullscreen === true
const showOntology = entry.id === 'ontology'
const showSchemaBrowser = entry.id === 'schema-browser'
const showEntityFields = entry.id === 'entity-fields'
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  pathname={pathname}
  headings={isInteractive ? [] : headings}
  fullscreen={isInteractive}
>
  {showOntology ? (
    <OntologyBrowser client:visible />
  ) : showSchemaBrowser ? (
    <SchemaReference client:visible />
  ) : showEntityFields ? (
    <YamlSchemas client:visible />
  ) : (
    <Content />
  )}
</DocLayout>
