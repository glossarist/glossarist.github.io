---
import { softwareNavItems } from '../data/projects'

const nav = [
  {
    text: 'Model',
    items: [
      { text: 'Overview', link: '/model/' },
      { text: 'Concepts', link: '/model/concepts' },
      { text: 'Designations', link: '/model/designations' },
      { text: 'Relationships', link: '/model/relationships' },
      { text: 'Sources', link: '/model/sources' },
      { text: 'Datasets & Sections', link: '/model/datasets' },
      { text: 'Non-verbal Entities', link: '/model/non-verbal' },
      { text: 'Term Types', link: '/model/term-types' },
    ],
  },
  {
    text: 'Reference',
    items: [
      { text: 'Overview', link: '/reference/' },
      { text: 'Schema Browser', link: '/reference/schema-browser' },
      { text: 'Entity Fields', link: '/reference/entity-fields' },
      { text: 'Ontology Browser', link: '/reference/ontology' },
      { text: 'Standards', link: '/reference/standards' },
    ],
  },
  { text: 'Software', items: softwareNavItems },
  {
    text: 'Docs',
    items: [
      { text: 'Core Concepts', link: '/docs/core-concepts/' },
      { text: 'Adopt Glossarist', link: '/docs/adopt/' },
    ],
  },
  { text: 'Blog', link: '/blog/' },
  { text: 'About', link: '/about' },
]

// Normalize a path for comparison: strip trailing slash unless it's the root,
// and strip a trailing `.html` (Astro.url.pathname returns the OUTPUT filename
// during static build, but the served URL omits the .html extension).
function norm(p: string): string {
  let n = p
  if (n.endsWith('.html')) n = n.slice(0, -5)
  if (n === '') return '/'
  if (n !== '/' && n.endsWith('/')) n = n.slice(0, -1)
  return n
}

const current = norm(Astro.url.pathname)

// A sub-link is active if current === link OR current starts with `${link}/`.
// For directory links like `/model/`, this matches `/model/concepts`
// but not `/docs/model-foo` (false-positive guard for sibling prefixes).
function linkActive(link: string): boolean {
  const n = norm(link)
  return current === n || current.startsWith(n + '/')
}

// A dropdown parent is active if any of its children is active.
function parentActive(item: { items?: { link: string }[], link?: string }): boolean {
  if (item.items) return item.items.some(sub => linkActive(sub.link))
  return item.link ? linkActive(item.link) : false
}
---

<header class="flex items-center gap-6 px-6 py-3 border-b border-[var(--g-divider)] bg-[var(--g-bg)] sticky top-0 z-50">
  <a href="/" class="flex items-center gap-2 no-underline" style="font-family: var(--g-font-display); font-weight: 700; font-size: 1.25rem; letter-spacing: -0.03em; color: var(--g-text-1);">
    <img src="/logo-glossarist.svg" alt="Glossarist" width="32" height="32" />
    <span>Glossarist</span>
  </a>

  <nav class="flex items-center gap-4 ml-auto">
    {nav.map((item) => {
      const parentOn = parentActive(item)
      return (
      <div class="group relative">
        {item.items ? (
          <>
            <button
              class:list={[
                'bg-transparent border-none px-3 py-2 cursor-pointer font-inherit hover:text-brand',
                parentOn ? 'text-brand font-semibold' : 'text-[var(--g-text-1)]',
              ]}
            >
              {item.text}
            </button>
            <ul class="absolute top-full left-0 bg-[var(--g-bg)] border border-[var(--g-divider)] rounded-lg p-2 list-none m-0 min-w-[200px] hidden group-hover:block shadow-lg">
              {item.items.map((sub) => {
                const on = linkActive(sub.link)
                return (
                  <li>
                    <a
                      href={sub.link}
                      class:list={[
                        'block px-2 py-1.5 rounded no-underline hover:bg-[var(--g-bg-soft)]',
                        on
                          ? 'text-brand font-semibold'
                          : 'text-[var(--g-text-1)] hover:text-brand',
                      ]}
                    >{sub.text}</a>
                  </li>
                )
              })}
            </ul>
          </>
        ) : (
          <a
            href={item.link}
            class:list={[
              'px-3 py-2 no-underline hover:text-brand',
              parentOn ? 'text-brand font-semibold' : 'text-[var(--g-text-1)]',
            ]}
          >{item.text}</a>
        )}
      </div>
      )
    })}
  </nav>

  <div class="flex items-center gap-2 ml-1">
    <button
      type="button"
      class="search-trigger flex items-center gap-2 bg-[var(--g-bg-soft)] border border-[var(--g-divider)] px-2.5 py-1.5 rounded-md text-[var(--g-text-2)] cursor-pointer font-inherit text-xs hover:bg-[var(--g-bg-alt)] hover:text-[var(--g-text-1)]"
      id="search-trigger"
      aria-label="Search"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <span class="hidden sm:inline">Search</span>
      <kbd class="font-mono text-[11px] px-1 py-0.5 border border-[var(--g-divider)] rounded bg-[var(--g-bg)] text-[var(--g-text-3)]">⌘K</kbd>
    </button>

    <button
      type="button"
      class="theme-toggle flex items-center justify-center bg-transparent border border-transparent px-1.5 py-1.5 rounded-md text-[var(--g-text-2)] cursor-pointer hover:bg-[var(--g-bg-soft)] hover:text-[var(--g-text-1)]"
      id="theme-toggle"
      aria-label="Toggle dark mode"
      title="Toggle theme"
    >
      <svg class="theme-icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1" x2="12" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/>
        <line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
      <svg class="theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
</header>

<dialog
  id="search-dialog"
  class="search-dialog w-[min(640px,90vw)] max-h-[80vh] p-0 border border-[var(--g-divider)] rounded-xl bg-[var(--g-bg)] shadow-2xl mt-[10vh]"
>
  <div class="flex flex-col max-h-[80vh] relative">
    <input
      type="text"
      id="search-input"
      placeholder="Search the docs…"
      autocomplete="off"
      class="w-full p-4 px-5 border-none border-b border-[var(--g-divider)] text-base bg-transparent text-[var(--g-text-1)] outline-none"
    />
    <div id="search-results" class="search-results overflow-y-auto p-2 flex-1"></div>
    <button
      class="absolute top-2.5 right-2.5 bg-transparent border border-[var(--g-divider)] rounded px-2 py-1 text-xs text-[var(--g-text-3)] cursor-pointer"
      id="search-close"
      aria-label="Close"
    >Esc</button>
  </div>
</dialog>

<style>
.theme-icon-dark { display: none; }
:global(.dark) .theme-icon-light { display: none; }
:global(.dark) .theme-icon-dark { display: inline; }
:global(#search-dialog::backdrop) {
  background: rgba(0, 0, 0, 0.4);
}
:global(.search-result) {
  display: block;
  padding: 0.625rem 0.75rem;
  border-radius: 6px;
  text-decoration: none;
  color: var(--g-text-1);
}
:global(.search-result:hover),
:global(.search-result.active) {
  background: var(--g-bg-soft);
}
:global(.search-result-title) {
  font-weight: 600;
  font-size: 0.9375rem;
  margin-bottom: 0.125rem;
}
:global(.search-result-excerpt) {
  font-size: 0.8125rem;
  color: var(--g-text-2);
  line-height: 1.4;
}
:global(.search-result-excerpt mark) {
  background: var(--g-brand-soft);
  color: var(--g-brand);
  padding: 0.0625rem 0.125rem;
  border-radius: 2px;
}
:global(.search-empty) {
  padding: 1.5rem;
  text-align: center;
  color: var(--g-text-3);
  font-size: 0.875rem;
}
:global(.search-loader) {
  padding: 1rem;
  text-align: center;
  color: var(--g-text-3);
  font-size: 0.875rem;
}
</style>

<script>
  // ----- Theme toggle -----
  const themeToggle = document.getElementById('theme-toggle')
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark')
    localStorage.setItem('glossarist-theme', isDark ? 'dark' : 'light')
  })

  // ----- Search dialog -----
  const trigger = document.getElementById('search-trigger')
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null
  const input = document.getElementById('search-input') as HTMLInputElement | null
  const closeBtn = document.getElementById('search-close')
  const resultsEl = document.getElementById('search-results')

  function open() {
    if (!dialog) return
    dialog.showModal()
    setTimeout(() => input?.focus(), 50)
  }

  function close() {
    dialog?.close()
    if (input) input.value = ''
    if (resultsEl) resultsEl.innerHTML = ''
    clearActive()
  }

  function clearActive() {
    resultsEl?.querySelectorAll('.active').forEach(el => el.classList.remove('active'))
  }

  function setActive(idx: number) {
    if (!resultsEl) return
    const items = Array.from(resultsEl.querySelectorAll<HTMLElement>('.search-result'))
    if (items.length === 0) return
    clearActive()
    const wrapped = (idx + items.length) % items.length
    items[wrapped].classList.add('active')
    items[wrapped].scrollIntoView({ block: 'nearest' })
  }

  trigger?.addEventListener('click', open)
  closeBtn?.addEventListener('click', close)
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) close()
  })
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault()
      dialog?.open ? close() : open()
    }
    if (e.key === 'Escape' && dialog?.open) close()
    if (dialog?.open && resultsEl) {
      const items = resultsEl.querySelectorAll('.search-result')
      if (items.length === 0) return
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(currentIdx + 1) }
      if (e.key === 'ArrowUp') { e.preventDefault(); setActive(currentIdx - 1) }
    }
  })

  let currentIdx = -1

  // ----- Pagefind -----
  let pagefind: any = null
  // Pagefind's entry module only exists after `astro build` (it writes dist/pagefind/).
  // Hide the dynamic import from Vite's static analyzer via `new Function`.
  const runtimeImport = new Function('url', 'return import(url)') as (url: string) => Promise<any>
  async function ensurePagefind() {
    if (pagefind) return pagefind
    try {
      pagefind = await runtimeImport('/pagefind/pagefind.js')
      await pagefind.options?.({ basePath: '/pagefind/' })
      await pagefind.init()
    } catch {
      pagefind = null
    }
    return pagefind
  }

  let searchTimer: number | undefined
  input?.addEventListener('input', () => {
    if (!input || !resultsEl) return
    const q = input.value.trim()
    clearTimeout(searchTimer)
    if (!q) {
      resultsEl.innerHTML = ''
      clearActive()
      currentIdx = -1
      return
    }
    resultsEl.innerHTML = '<div class="search-loader">Searching…</div>'
    searchTimer = window.setTimeout(async () => {
      const pf = await ensurePagefind()
      if (!pf) {
        resultsEl.innerHTML = '<div class="search-empty">Search index unavailable. Run `astro build` first.</div>'
        return
      }
      const search = await pf.search(q)
      const top = search.results.slice(0, 10)
      const rendered = await Promise.all(top.map((r: any) => r.data()))
      currentIdx = -1
      if (rendered.length === 0) {
        resultsEl.innerHTML = '<div class="search-empty">No results.</div>'
        return
      }
      resultsEl.innerHTML = rendered.map((r: any) => {
        const title = r.meta?.title ?? r.url
        return `<a href="${r.url}" class="search-result">
          <div class="search-result-title">${escapeHtml(title)}</div>
          <div class="search-result-excerpt">${r.excerpt}</div>
        </a>`
      }).join('')
      // Re-query after innerHTML swap so setActive targets fresh nodes
      const fresh = resultsEl.querySelectorAll('.search-result')
      fresh.forEach(el => el.addEventListener('click', () => close()))
    }, 150)
  })

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
  }
</script>
