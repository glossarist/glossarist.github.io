---
import { sidebarFor } from '../data/sidebars'

interface Props {
  pathname: string
}

const { pathname } = Astro.props
const sidebar = sidebarFor(pathname)

// Normalize: strip trailing slash (except root) and .html suffix for comparison
function norm(p: string): string {
  let n = p
  if (n.endsWith('.html')) n = n.slice(0, -5)
  if (n !== '/' && n.endsWith('/')) n = n.slice(0, -1)
  return n
}

// Exact match only — the current page is highlighted, not section roots.
// The dropdown BUTTON in the nav uses prefix matching to show which section
// you're in; individual sidebar links use exact matching so Overview is only
// highlighted when you're actually on the overview page.
function isActive(link: string, current: string): boolean {
  return norm(current) === norm(link)
}
---
<aside class="sidebar hidden md:block sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto py-4 pr-2 pl-6 text-sm w-64 border-r border-[var(--g-divider)]" aria-label="Section navigation">
  {sidebar.map(group => (
    <section class="mb-6">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-[var(--g-text-2)] mt-0 mb-2 px-2">{group.text}</h2>
      <ul class="list-none m-0 p-0">
        {group.items.map(item => (
          <li class="m-0">
            <a
              href={item.link}
              class:list={[
                'block px-2 py-1.5 rounded leading-snug no-underline',
                isActive(item.link, pathname)
                  ? 'nav-active text-brand font-semibold'
                  : 'text-[var(--g-text-1)] hover:bg-[var(--g-bg-soft)] hover:text-brand'
              ]}
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</aside>
