---
import { sidebarFor } from '../data/sidebars'

interface Props {
  pathname: string
}

const { pathname } = Astro.props
const sidebar = sidebarFor(pathname)

function isActive(link: string, current: string): boolean {
  if (link === current) return true
  // Match directory-style: /docs/desktop/ matches /docs/desktop
  if (link.endsWith('/') && current.startsWith(link)) return true
  return false
}
---
<aside class="sidebar" aria-label="Section navigation">
  {sidebar.map(group => (
    <section class="sidebar-group">
      <h2 class="sidebar-title">{group.text}</h2>
      <ul class="sidebar-items">
        {group.items.map(item => (
          <li>
            <a
              href={item.link}
              class:list={['sidebar-link', { active: isActive(item.link, pathname) }]}
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</aside>

<style>
.sidebar {
  position: sticky;
  top: 4rem;
  max-height: calc(100vh - 4rem);
  overflow-y: auto;
  padding: 1rem 0.5rem 1rem 1.5rem;
  font-size: 0.875rem;
  width: 16rem;
  border-right: 1px solid var(--vp-c-divider, #e5e7eb);
}
.sidebar-group {
  margin-bottom: 1.5rem;
}
.sidebar-title {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--vp-c-text-2, #4b5563);
  margin: 0 0 0.5rem;
  padding: 0 0.5rem;
}
.sidebar-items {
  list-style: none;
  margin: 0;
  padding: 0;
}
.sidebar-items li {
  margin: 0;
}
.sidebar-link {
  display: block;
  padding: 0.375rem 0.5rem;
  border-radius: 4px;
  color: var(--vp-c-text-1, #1f2937);
  text-decoration: none;
  line-height: 1.4;
}
.sidebar-link:hover {
  background: var(--vp-c-bg-soft, #f3f4f6);
  color: var(--vp-c-brand-1, #3b82f6);
}
.sidebar-link.active {
  color: var(--vp-c-brand-1, #3b82f6);
  font-weight: 600;
}

:global(.dark) .sidebar {
  border-right-color: var(--vp-c-divider, #2d2d2d);
}
:global(.dark) .sidebar-link {
  color: var(--vp-c-text-1, #e5e7eb);
}
:global(.dark) .sidebar-link:hover {
  background: var(--vp-c-bg-soft, #1f1f1f);
}

@media (max-width: 768px) {
  .sidebar {
    display: none;
  }
}
</style>
