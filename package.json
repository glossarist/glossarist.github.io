{
  "name": "glossarist.org",
  "version": "1.0.0",
  "description": "Glossarist - Open-source software for maintaining multi-language concept systems",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:data && astro build",
    "build:data": "node scripts/generate-ontology-data.mjs && node scripts/generate-ontology-schema.mjs && node scripts/copy-schemas.mjs && node scripts/bundle-schemas.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/vue": "^7.0.0",
    "astro": "^7.0.0",
    "astro-pagefind": "^2.0.0",
    "vue": "^3.5.13",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
